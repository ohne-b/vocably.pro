{{#> layout
  title='PDF Reader'
  metaDescription='Upload a PDF and read it right in your browser. Your document and reading position are stored locally on your device.'
  url='/pdf.html'
  noCta=true
  navbarContainerClass="container-md"
  nonStickyNavbar=true
  enableExtension=true
}}
  <style>
    /* ---------- Landing ---------- */
    .pdf-hero {
      padding-block: 3rem 3.5rem;
    }

    .pdf-hero__title {
      margin-bottom: 0.75rem;
      font-size: clamp(2rem, 5vw, 2.75rem);
      font-weight: 600;
      letter-spacing: -0.03em;
    }

    .pdf-hero__lead {
      max-width: 38rem;
      margin-bottom: 2rem;
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--bs-secondary-color);
    }

    .pdf-dropzone {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      width: 100%;
      padding: 2.75rem 1.5rem 2.25rem;
      border: 2px dashed rgba(var(--bs-primary-rgb), 0.28);
      border-radius: 1.25rem;
      background:
        radial-gradient(ellipse at top, rgba(var(--bs-primary-rgb), 0.07), transparent 70%),
        #fff;
      color: var(--bs-body-color);
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;

      &:hover,
      &:focus-visible,
      &.is-dragover {
        border-color: rgba(var(--bs-primary-rgb), 0.7);
        box-shadow: 0 10px 30px -12px rgba(var(--bs-primary-rgb), 0.35);
        outline: none;
      }

      &.is-dragover {
        background-color: rgba(var(--bs-primary-rgb), 0.06);
      }

      &:hover .pdf-dropzone__button {
        background: var(--bs-primary);
        color: #fff;
      }
    }

    .pdf-dropzone__icon {
      display: grid;
      place-items: center;
      width: 4rem;
      height: 4rem;
      margin-bottom: 0.75rem;
      border-radius: 1rem;
      background: rgba(var(--bs-primary-rgb), 0.1);
      color: var(--bs-primary);
      font-size: 1.9rem;
      transition: transform 0.2s ease;

      .is-dragover & {
        transform: translateY(-4px);
      }
    }

    .pdf-dropzone__title {
      font-family: 'Montserrat', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--bs-emphasis-color);
    }

    .pdf-dropzone__hint {
      font-size: 0.95rem;
      color: var(--bs-secondary-color);
    }

    .pdf-dropzone__button {
      margin-top: 1.25rem;
      padding: 0.6rem 1.5rem;
      border: 1px solid var(--bs-primary);
      border-radius: 999px;
      color: var(--bs-primary);
      font-size: 0.95rem;
      font-weight: 500;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .pdf-dropzone__note {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 1.5rem;
      font-size: 0.8rem;
      color: var(--bs-secondary-color);
    }

    /* "Continue reading" card */
    .pdf-recent {
      margin-top: 2rem;

      &[hidden] {
        display: none;
      }
    }

    .pdf-recent__label {
      margin-bottom: 0.75rem;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bs-secondary-color);
    }

    .pdf-recent__item {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.5rem 0.5rem 0.5rem 0.5rem;
      border: 1px solid var(--bs-border-color);
      border-radius: 1rem;
      background: #fff;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;

      &:hover {
        border-color: rgba(var(--bs-primary-rgb), 0.4);
        box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.2);
      }
    }

    .pdf-recent__open {
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      gap: 1rem;
      min-width: 0;
      padding: 0.25rem;
      border: 0;
      border-radius: 0.75rem;
      background: transparent;
      color: inherit;
      text-align: left;

      &:focus-visible {
        outline: 2px solid rgba(var(--bs-primary-rgb), 0.6);
      }

      &:hover .pdf-recent__cta {
        background: var(--bs-primary);
        color: #fff;
      }
    }

    .pdf-recent__thumb {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3.75rem;
      overflow: hidden;
      border: 1px solid var(--bs-border-color);
      border-radius: 0.375rem;
      background: #fff;
      color: #d93b3b;
      font-size: 1.5rem;

      canvas {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
      }
    }

    .pdf-recent__text {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
    }

    .pdf-recent__name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 1rem;
      font-weight: 500;
      color: var(--bs-emphasis-color);
    }

    .pdf-recent__meta {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.8rem;
      color: var(--bs-secondary-color);
    }

    .pdf-recent__cta {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.45rem 1rem;
      border-radius: 999px;
      background: rgba(var(--bs-primary-rgb), 0.1);
      color: var(--bs-primary);
      font-size: 0.875rem;
      font-weight: 500;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .pdf-recent__delete {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--bs-secondary-color);
      font-size: 1rem;
      transition: background-color 0.15s ease, color 0.15s ease;

      &:hover,
      &:focus-visible {
        background: rgba(var(--bs-danger-rgb), 0.1);
        color: var(--bs-danger);
      }
    }

    @media (max-width: 575.98px) {
      .pdf-recent__cta span {
        display: none;
      }
    }

    /* About */
    .pdf-about {
      padding-block: 3.5rem;
      border-top: 1px solid var(--bs-border-color);
      background: #f8f9fb;
    }

    .pdf-about__title {
      margin-bottom: 2rem;
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .pdf-features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
    }

    .pdf-feature {
      padding: 1.25rem;
      border: 1px solid var(--bs-border-color);
      border-radius: 1rem;
      background: #fff;

      h3 {
        margin: 0.9rem 0 0.4rem;
        font-size: 1rem;
        font-weight: 600;
        color: var(--bs-emphasis-color);
        letter-spacing: -1px;
      }

      p {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--bs-secondary-color);
      }
    }

    .pdf-feature__icon {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.75rem;
      background: rgba(var(--bs-primary-rgb), 0.1);
      color: var(--bs-primary);
      font-size: 1.15rem;
    }

    .pdf-install__text {
      margin-bottom: 1rem;
      font-size: 0.95rem;
      color: var(--bs-secondary-color);
    }

    /* ---------- Reader ---------- */
    .pdf-reader {
      position: fixed;
      inset: 0;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      background: #3a3d41;
      color: #fff;

      &[hidden] {
        display: none;
      }
    }

    .pdf-reader__toolbar {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background: rgba(28, 29, 32, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
    }

    .pdf-reader__title {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.95rem;
      font-weight: 500;
      padding-inline: 0.25rem;
    }

    /* Pill that groups related controls. */
    .pdf-group {
      display: flex;
      align-items: center;
      gap: 0.125rem;
      padding: 0.2rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
    }

    .pdf-icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.125rem;
      height: 2.125rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: inherit;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.15s ease;

      &:hover {
        background: rgba(255, 255, 255, 0.14);
      }

      &:active {
        background: rgba(255, 255, 255, 0.22);
      }

      &:focus-visible {
        outline: 2px solid rgba(var(--bs-primary-rgb), 0.9);
        outline-offset: 1px;
      }

      &:disabled {
        opacity: 0.35;
        pointer-events: none;
      }
    }

    .pdf-zoom-level {
      min-width: 3.25rem;
      text-align: center;
    }

    .pdf-page-input {
      width: 2.75rem;
      height: 1.75rem;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      color: inherit;
      text-align: center;
      font: inherit;
      appearance: textfield;

      &::-webkit-inner-spin-button,
      &::-webkit-outer-spin-button {
        appearance: none;
        margin: 0;
      }

      &:focus {
        outline: 2px solid rgba(var(--bs-primary-rgb), 0.9);
      }
    }

    .pdf-page-count {
      padding-inline: 0.35rem 0.1rem;
      color: rgba(255, 255, 255, 0.6);
    }

    @media (max-width: 575.98px) {
      .pdf-zoom-level {
        display: none;
      }
    }

    .pdf-reader__pages {
      flex: 1 1 auto;
      overflow: auto;
      padding: 1.5rem 0.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .pdf-reader__spinner {
      margin: 3rem auto;
    }

    /* A page = canvas (visual) + .textLayer (selectable text) stacked. */
    .pdf-reader__page {
      position: relative;
      flex: 0 0 auto;
      overflow: hidden;
      border-radius: 0.375rem;
      background: #fff;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      --scale-round-x: 1px;
      --scale-round-y: 1px;

      canvas {
        display: block;
      }
    }

    /* --- Official PDF.js text-layer styles (v6) --- */
    .textLayer {
      color-scheme: only light;
      position: absolute;
      text-align: initial;
      inset: 0;
      overflow: clip;
      opacity: 1;
      line-height: 1;
      letter-spacing: normal;
      word-spacing: normal;
      text-size-adjust: none;
      forced-color-adjust: none;
      transform-origin: 0 0;
      caret-color: CanvasText;
      z-index: 0;
    }

    .textLayer.highlighting {
      touch-action: none;
    }

    .textLayer :is(span, br) {
      color: transparent;
      position: absolute;
      white-space: pre;
      cursor: text;
      user-select: text;
      transform-origin: 0% 0%;
    }

    .textLayer {
      --min-font-size: 1;
      --text-scale-factor: calc(var(--total-scale-factor) * var(--min-font-size));
      --min-font-size-inv: calc(1 / var(--min-font-size));
    }

    .textLayer > :not(.markedContent),
    .textLayer .markedContent span:not(.markedContent) {
      z-index: 1;
      --font-height: 0;
      font-size: calc(var(--text-scale-factor) * var(--font-height));
      --scale-x: 1;
      --rotate: 0deg;
      transform: rotate(var(--rotate)) scaleX(var(--scale-x)) scale(var(--min-font-size-inv));
    }

    .textLayer .markedContent {
      display: contents;
    }

    .textLayer span[role='img'] {
      user-select: none;
      cursor: default;
    }

    .textLayer ::selection {
      background: rgba(0, 0, 255, 0.25);
      background: color-mix(in srgb, AccentColor, transparent 50%);
      color: transparent;
    }

    .textLayer br::selection {
      background: transparent;
    }

    .textLayer .endOfContent {
      display: block;
      position: absolute;
      inset: 100% 0 0;
      z-index: 0;
      cursor: default;
      user-select: none;
    }

    .textLayer.selecting .endOfContent {
      top: 0;
    }
  </style>

  <div id="pdfLanding">
    <section class="pdf-hero">
      <div class="container-md">
        <h1 class="pdf-hero__title">Online PDF Reader</h1>
        <p class="pdf-hero__lead">
          Open any PDF and read it right in your browser. Translate words and sentences with Vocably as you go.
        </p>

        <input type="file" id="pdfFileInput" accept="application/pdf,.pdf" hidden />

        <button type="button" id="pdfUploadButton" class="pdf-dropzone">
          <span class="pdf-dropzone__icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
          <span class="pdf-dropzone__title">Drop a PDF file here</span>
          <span class="pdf-dropzone__hint">or click anywhere in this area</span>
          <span class="pdf-dropzone__button">Choose file</span>
          <span class="pdf-dropzone__note">
            <i class="bi bi-shield-lock"></i>
            Your file stays on your device and is never uploaded
          </span>
        </button>

        <div id="pdfLastDoc" class="pdf-recent" hidden>
          <div class="pdf-recent__label">Continue reading</div>
          <div class="pdf-recent__item">
            <button type="button" id="pdfOpenLast" class="pdf-recent__open">
              <span id="pdfLastDocThumb" class="pdf-recent__thumb">
                <i class="bi bi-file-earmark-pdf-fill"></i>
              </span>
              <span class="pdf-recent__text">
                <span id="pdfLastDocName" class="pdf-recent__name"></span>
                <span id="pdfLastDocMeta" class="pdf-recent__meta"></span>
              </span>
              <span class="pdf-recent__cta"><span>Open</span><i class="bi bi-arrow-right"></i></span>
            </button>
            <button type="button" id="pdfDeleteLast" class="pdf-recent__delete" aria-label="Remove document" title="Remove document">
              <i class="bi bi-trash3"></i>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="pdf-about">
      <div class="container-md">
        <h2 class="pdf-about__title">A private, extension-friendly PDF reader</h2>

        <div class="pdf-features">
          <div class="pdf-feature">
            <span class="pdf-feature__icon"><i class="bi bi-shield-lock"></i></span>
            <h3>Private by design</h3>
            <p>Files are never uploaded to a server. They stay entirely in your browser.</p>
          </div>
          <div class="pdf-feature">
            <span class="pdf-feature__icon"><i class="bi bi-translate"></i></span>
            <h3>Translate as you read</h3>
            <p>Select text to translate sentences and save new words with Vocably.</p>
          </div>
          <div class="pdf-feature">
            <span class="pdf-feature__icon"><i class="bi bi-bookmark-check"></i></span>
            <h3>Resume anytime</h3>
            <p>Your document, page and zoom level are remembered for the next session.</p>
          </div>
        </div>

        <p class="pdf-install__text">Don't have the Vocably extension yet? Install it here:</p>
        {{> extension-buttons}}
      </div>
    </section>
  </div>

  <!-- Reader (hidden until a document is opened) -->
  <div id="pdfReader" class="pdf-reader" hidden>
    <div class="pdf-reader__toolbar">
      <button type="button" id="pdfBack" class="pdf-icon-btn" title="Back" aria-label="Back">
        <i class="bi bi-arrow-left"></i>
      </button>
      <span id="pdfReaderTitle" class="pdf-reader__title"></span>

      <div class="pdf-group" role="group" aria-label="Zoom">
        <button type="button" id="pdfZoomOut" class="pdf-icon-btn" title="Zoom out" aria-label="Zoom out">
          <i class="bi bi-dash-lg"></i>
        </button>
        <span id="pdfZoomLevel" class="pdf-zoom-level">100%</span>
        <button type="button" id="pdfZoomIn" class="pdf-icon-btn" title="Zoom in" aria-label="Zoom in">
          <i class="bi bi-plus-lg"></i>
        </button>
      </div>

      <div class="pdf-group" role="group" aria-label="Pages">
        <button type="button" id="pdfPrev" class="pdf-icon-btn" title="Previous page" aria-label="Previous page">
          <i class="bi bi-chevron-up"></i>
        </button>
        <input type="number" id="pdfPageInput" class="pdf-page-input" min="1" value="1" aria-label="Page number" />
        <span class="pdf-page-count">/&nbsp;<span id="pdfPageCount">?</span></span>
        <button type="button" id="pdfNext" class="pdf-icon-btn" title="Next page" aria-label="Next page">
          <i class="bi bi-chevron-down"></i>
        </button>
      </div>
    </div>
    <div id="pdfPages" class="pdf-reader__pages"></div>
  </div>

  <!-- PDF.js v6 is ESM-only (no UMD global), so it is loaded as a module.
       v6 has no SVG backend, so pages are drawn on a <canvas> with an HTML
       .textLayer overlaid on top to keep the text selectable. -->
  <script type="module">
    import * as PDFJS from 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/6.1.200/pdf.min.mjs';

    PDFJS.GlobalWorkerOptions.workerSrc =
      'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/6.1.200/pdf.worker.min.mjs';

    const MIN_SCALE = 0.4;
    const MAX_SCALE = 4;
    const ZOOM_STEP = 0.2;
    const PAGE_GAP = 16;

    // ---- Storage: a single document kept in IndexedDB ----
    const storage = (() => {
      const DB_NAME = 'vocably-pdf-reader';
      const STORE = 'documents';
      const DOC_ID = 'current';

      let dbPromise;
      const openDb = () =>
        (dbPromise ??= new Promise((resolve, reject) => {
          const request = indexedDB.open(DB_NAME, 1);
          request.onupgradeneeded = () => {
            if (!request.result.objectStoreNames.contains(STORE)) {
              request.result.createObjectStore(STORE, { keyPath: 'id' });
            }
          };
          request.onsuccess = () => resolve(request.result);
          request.onerror = () => reject(request.error);
        }));

      // Runs `fn` against the store and resolves with its request's result
      // once the transaction commits.
      const withStore = async (mode, fn) => {
        const db = await openDb();
        return new Promise((resolve, reject) => {
          const tx = db.transaction(STORE, mode);
          const request = fn(tx.objectStore(STORE));
          tx.oncomplete = () => resolve(request?.result);
          tx.onerror = () => reject(tx.error);
        });
      };

      return {
        get: async () => (await withStore('readonly', (store) => store.get(DOC_ID))) ?? null,
        save: (doc) => withStore('readwrite', (store) => store.put({ ...doc, id: DOC_ID })),
        remove: () => withStore('readwrite', (store) => store.delete(DOC_ID)),
        // Merges a partial update (page, scale, ...) into the stored document.
        update: (patch) =>
          withStore('readwrite', (store) => {
            const request = store.get(DOC_ID);
            request.onsuccess = () => {
              if (request.result) {
                store.put({ ...request.result, ...patch });
              }
            };
          }),
      };
    })();

    // ---- Elements ----
    const $ = (id) => document.getElementById(id);
    const ui = {
      fileInput: $('pdfFileInput'),
      uploadButton: $('pdfUploadButton'),
      lastDoc: $('pdfLastDoc'),
      lastDocName: $('pdfLastDocName'),
      lastDocMeta: $('pdfLastDocMeta'),
      lastDocThumb: $('pdfLastDocThumb'),
      openLast: $('pdfOpenLast'),
      deleteLast: $('pdfDeleteLast'),
      reader: $('pdfReader'),
      title: $('pdfReaderTitle'),
      pages: $('pdfPages'),
      back: $('pdfBack'),
      prev: $('pdfPrev'),
      next: $('pdfNext'),
      pageInput: $('pdfPageInput'),
      pageCount: $('pdfPageCount'),
      zoomIn: $('pdfZoomIn'),
      zoomOut: $('pdfZoomOut'),
      zoomLevel: $('pdfZoomLevel'),
    };

    // ---- Reader state ----
    const state = {
      pdf: null,
      loadingTask: null, // owns the worker-side document; destroyed on close
      scale: 1,
      currentPage: 1,
      renders: new Map(), // pageNumber -> in-flight/finished render promise
      observer: null, // lazily renders pages as they approach the viewport
      suppressScrollTracking: false,
    };

    const isReaderOpen = () => !ui.reader.hidden;
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const pageElement = (pageNumber) => ui.pages.querySelector(`[data-page="${pageNumber}"]`);

    // ---- Landing ----
    const formatSize = (bytes) =>
      bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`;

    const formatRelativeTime = (timestamp) => {
      const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
      const seconds = (timestamp - Date.now()) / 1000;
      const units = [
        ['year', 31536000],
        ['month', 2592000],
        ['week', 604800],
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
      ];
      for (const [unit, size] of units) {
        if (Math.abs(seconds) >= size) {
          return rtf.format(Math.round(seconds / size), unit);
        }
      }
      return 'just now';
    };

    const describeDoc = (doc) =>
      [
        doc.numPages ? `Page ${doc.page ?? 1} of ${doc.numPages}` : `Page ${doc.page ?? 1}`,
        formatSize(doc.data.byteLength),
        doc.updatedAt && `Opened ${formatRelativeTime(doc.updatedAt)}`,
      ]
        .filter(Boolean)
        .join(' · ');

    const THUMB_ICON = '<i class="bi bi-file-earmark-pdf-fill"></i>';
    let thumbToken = 0;

    // Renders the first page into the "Continue reading" card.
    const renderThumbnail = async (doc) => {
      const token = ++thumbToken;
      ui.lastDocThumb.innerHTML = THUMB_ICON;
      const loadingTask = PDFJS.getDocument({ data: doc.data.slice(0) });
      try {
        const pdf = await loadingTask.promise;
        const page = await pdf.getPage(1);
        const { width } = page.getViewport({ scale: 1 });
        const scale = (ui.lastDocThumb.clientWidth * (window.devicePixelRatio || 1) * 1.5) / width;
        const viewport = page.getViewport({ scale });
        const canvas = document.createElement('canvas');
        canvas.width = Math.floor(viewport.width);
        canvas.height = Math.floor(viewport.height);
        await page.render({ canvas, viewport }).promise;
        if (token === thumbToken) {
          ui.lastDocThumb.replaceChildren(canvas);
        }
      } catch (error) {
        console.error(error);
      } finally {
        loadingTask.destroy();
      }
    };

    const showLastDoc = (doc) => {
      ui.lastDoc.hidden = !doc;
      ui.lastDocName.textContent = doc?.name ?? '';
      ui.lastDocMeta.textContent = doc ? describeDoc(doc) : '';
      if (doc) {
        renderThumbnail(doc);
      } else {
        thumbToken++;
        ui.lastDocThumb.innerHTML = THUMB_ICON;
      }
    };

    const refreshLanding = async () => showLastDoc(await storage.get());

    // ---- Rendering (canvas image + HTML text layer for selection) ----
    const renderPage = (pageNumber) => {
      if (!state.renders.has(pageNumber)) {
        const { renders } = state;
        const promise = drawPage(pageNumber).catch((error) => {
          // Allow a retry, unless the reader has been rebuilt meanwhile.
          renders.delete(pageNumber);
          console.error(error);
        });
        renders.set(pageNumber, promise);
      }
      return state.renders.get(pageNumber);
    };

    const drawPage = async (pageNumber) => {
      const { pdf, scale } = state;
      const page = await pdf.getPage(pageNumber);
      const viewport = page.getViewport({ scale });
      const ratio = window.devicePixelRatio || 1;

      // Visual layer: canvas rendered at device pixel ratio for crispness.
      const canvas = document.createElement('canvas');
      canvas.width = Math.floor(viewport.width * ratio);
      canvas.height = Math.floor(viewport.height * ratio);
      canvas.style.width = '100%';
      canvas.style.height = '100%';

      // Text layer: transparent, selectable HTML on top of the canvas.
      const textLayerDiv = document.createElement('div');
      textLayerDiv.className = 'textLayer';

      await Promise.all([
        page.render({
          canvas,
          viewport,
          transform: ratio !== 1 ? [ratio, 0, 0, ratio, 0, 0] : undefined,
        }).promise,
        new PDFJS.TextLayer({
          textContentSource: page.streamTextContent(),
          container: textLayerDiv,
          viewport,
        }).render(),
      ]);

      // The reader may have been zoomed or closed while this page was rendering.
      if (state.pdf !== pdf || state.scale !== scale) {
        return;
      }

      const el = pageElement(pageNumber);
      sizePage(el, viewport);
      el.replaceChildren(canvas, textLayerDiv);
    };

    const sizePage = (el, viewport) => {
      el.style.width = `${Math.floor(viewport.width)}px`;
      el.style.height = `${Math.floor(viewport.height)}px`;
      // Drives the text layer's font sizing / positioning math.
      el.style.setProperty('--total-scale-factor', String(state.scale));
    };

    // Creates a correctly-sized placeholder per page; the observer renders
    // them lazily as they scroll into (or near) view.
    const buildPages = async () => {
      // Size placeholders after page 1 — close enough for most documents,
      // and each page snaps to its real size once rendered.
      const firstPage = await state.pdf.getPage(1);
      const viewport = firstPage.getViewport({ scale: state.scale });

      state.observer?.disconnect();
      state.renders = new Map();

      const placeholders = Array.from({ length: state.pdf.numPages }, (_, i) => {
        const el = document.createElement('div');
        el.className = 'pdf-reader__page';
        el.dataset.page = String(i + 1);
        sizePage(el, viewport);
        return el;
      });
      ui.pages.replaceChildren(...placeholders);

      state.observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              renderPage(Number(entry.target.dataset.page));
            }
          }
        },
        { root: ui.pages, rootMargin: '100% 0px' },
      );
      placeholders.forEach((el) => state.observer.observe(el));
    };

    const setCurrentPage = (pageNumber, { persist = true } = {}) => {
      state.currentPage = pageNumber;
      ui.pageInput.value = String(pageNumber);
      ui.prev.disabled = pageNumber <= 1;
      ui.next.disabled = pageNumber >= state.pdf.numPages;
      if (persist) {
        storage.update({ page: pageNumber });
      }
    };

    const goToPage = async (pageNumber, options) => {
      pageNumber = clamp(pageNumber, 1, state.pdf.numPages);
      setCurrentPage(pageNumber, options);

      // Render the target first so the scroll lands on its real size.
      await renderPage(pageNumber);
      const el = pageElement(pageNumber);
      if (!el) {
        return;
      }
      state.suppressScrollTracking = true;
      ui.pages.scrollTop = el.offsetTop - ui.pages.offsetTop - PAGE_GAP;
      setTimeout(() => (state.suppressScrollTracking = false), 100);
    };

    // The page closest to the middle of the viewport is the current one.
    const updateCurrentPageFromScroll = () => {
      const containerRect = ui.pages.getBoundingClientRect();
      const middle = containerRect.top + containerRect.height / 2;

      let closest = state.currentPage;
      let closestDistance = Infinity;
      for (const el of ui.pages.children) {
        const rect = el.getBoundingClientRect();
        const distance = Math.abs(rect.top + rect.height / 2 - middle);
        if (distance < closestDistance) {
          closestDistance = distance;
          closest = Number(el.dataset.page);
        }
      }

      if (closest !== state.currentPage) {
        setCurrentPage(closest);
      }
    };

    const debounce = (fn, ms) => {
      let timer;
      return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(() => fn(...args), ms);
      };
    };

    // ---- Zoom ----
    const updateZoomUi = () => {
      ui.zoomLevel.textContent = `${Math.round(state.scale * 100)}%`;
      ui.zoomOut.disabled = state.scale <= MIN_SCALE;
      ui.zoomIn.disabled = state.scale >= MAX_SCALE;
    };

    const setScale = async (scale) => {
      state.scale = clamp(scale, MIN_SCALE, MAX_SCALE);
      updateZoomUi();
      storage.update({ scale: state.scale });
      await buildPages();
      await goToPage(state.currentPage, { persist: false });
    };

    // Fits the page width to the reader, so canvas and text stay aligned.
    const fitWidthScale = async () => {
      const firstPage = await state.pdf.getPage(1);
      const { width } = firstPage.getViewport({ scale: 1 });
      return clamp((ui.pages.clientWidth - 24) / width, MIN_SCALE, 3);
    };

    // ---- Open / close reader ----
    const openReader = async (doc) => {
      ui.title.textContent = doc.name;
      ui.pageCount.textContent = '?';
      ui.pages.innerHTML =
        '<div class="spinner-border text-light pdf-reader__spinner" role="status"><span class="visually-hidden">Loading…</span></div>';
      ui.reader.hidden = false;
      document.body.style.overflow = 'hidden';

      // pdf.js transfers (detaches) the buffer, so hand it a copy.
      state.loadingTask = PDFJS.getDocument({ data: doc.data.slice(0) });
      state.pdf = await state.loadingTask.promise;
      ui.pageCount.textContent = String(state.pdf.numPages);
      ui.pageInput.max = String(state.pdf.numPages);
      storage.update({ numPages: state.pdf.numPages, updatedAt: Date.now() });

      state.scale = doc.scale ?? (await fitWidthScale());
      updateZoomUi();
      await buildPages();
      await goToPage(doc.page ?? 1, { persist: false });
    };

    const closeReader = () => {
      ui.reader.hidden = true;
      document.body.style.overflow = '';
      state.observer?.disconnect();
      state.observer = null;
      state.renders = new Map();
      ui.pages.replaceChildren();
      state.loadingTask?.destroy();
      state.loadingTask = null;
      state.pdf = null;
      refreshLanding();
    };

    // ---- File handling ----
    const isPdf = (file) => file.type === 'application/pdf' || /\.pdf$/i.test(file.name);

    const handleFile = async (file) => {
      if (!file) {
        return;
      }
      if (!isPdf(file)) {
        alert('Please choose a PDF file.');
        return;
      }
      const doc = {
        name: file.name,
        data: await file.arrayBuffer(),
        page: 1,
        updatedAt: Date.now(),
      };
      await storage.save(doc);
      showLastDoc(doc);
      await openReader(doc);
    };

    // ---- Wire up UI ----
    ui.uploadButton.addEventListener('click', () => ui.fileInput.click());

    ui.fileInput.addEventListener('change', () => {
      handleFile(ui.fileInput.files?.[0]);
      ui.fileInput.value = '';
    });

    for (const type of ['dragenter', 'dragover', 'dragleave', 'drop']) {
      ui.uploadButton.addEventListener(type, (event) => {
        event.preventDefault();
        const isOver = type === 'dragenter' || type === 'dragover';
        ui.uploadButton.classList.toggle('is-dragover', isOver);
        if (type === 'drop') {
          handleFile(event.dataTransfer?.files[0]);
        }
      });
    }

    ui.openLast.addEventListener('click', async () => {
      const doc = await storage.get();
      if (doc) {
        await openReader(doc);
      }
    });

    ui.deleteLast.addEventListener('click', async () => {
      if (confirm('Remove this document from your browser?')) {
        await storage.remove();
        showLastDoc(null);
      }
    });

    ui.back.addEventListener('click', closeReader);
    ui.prev.addEventListener('click', () => goToPage(state.currentPage - 1));
    ui.next.addEventListener('click', () => goToPage(state.currentPage + 1));
    ui.pageInput.addEventListener('change', () => {
      const value = parseInt(ui.pageInput.value, 10);
      if (Number.isNaN(value)) {
        ui.pageInput.value = String(state.currentPage);
      } else {
        goToPage(value);
      }
    });

    ui.zoomIn.addEventListener('click', () => setScale(state.scale + ZOOM_STEP));
    ui.zoomOut.addEventListener('click', () => setScale(state.scale - ZOOM_STEP));

    ui.pages.addEventListener(
      'scroll',
      debounce(() => {
        if (!state.suppressScrollTracking) {
          updateCurrentPageFromScroll();
        }
      }, 150),
    );

    document.addEventListener('keydown', (event) => {
      if (!isReaderOpen() || !state.pdf || event.target === ui.pageInput) {
        return;
      }
      switch (event.key) {
        case 'Escape':
          closeReader();
          break;
        case 'ArrowRight':
        case 'PageDown':
          goToPage(state.currentPage + 1);
          break;
        case 'ArrowLeft':
        case 'PageUp':
          goToPage(state.currentPage - 1);
          break;
      }
    });

    // ---- Init ----
    refreshLanding();
  </script>
{{/layout}}
