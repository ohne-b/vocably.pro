{{#> layout
  title='Install Mobile App'
  url='/qr.html'
  disableAnalytics=true
  noCta=true
}}
  {{#> text-container }}
    <style>
      .app-install {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        justify-content: center;
        max-width: 860px;
        margin: 3rem auto;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.06);
        overflow: hidden;
      }

      .app-install__main {
        flex: 1 1 340px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        padding: 3rem 2rem;
        text-align: center;
      }

      .app-install__title {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .app-install__main .progress {
        width: 100%;
        max-width: 280px;
      }

      .app-install__stores {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
      }

      .app-install__stores.d-none {
        display: none !important;
      }

      .app-install__stores a {
        transition: transform 0.15s ease-in-out;
      }

      .app-install__stores a:hover {
        transform: translateY(-2px);
      }

      .app-install__stores img {
        display: block;
        width: 170px;
        height: auto;
      }

      .app-install__qr {
        flex: 0 1 320px;
        display: flex;
        flex-direction: column-reverse;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 3rem 2rem;
        background: #f6f7f9;
        border-left: 1px solid rgba(0, 0, 0, 0.06);
        text-align: center;
        font-size: 0.9375rem;
        color: #6c757d;
      }

      .app-install__qr img {
        width: 200px;
        height: 200px;
        padding: 14px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.08);
      }

      @media (max-width: 767.98px) {
        .app-install {
          margin: 1.5rem auto;
        }

        .app-install__main,
        .app-install__qr {
          flex-basis: 100%;
          padding: 2.5rem 1.5rem;
        }

        .app-install__qr {
          border-left: 0;
          border-top: 1px solid rgba(0, 0, 0, 0.06);
        }
      }
    </style>

    <div class="app-install">
      <div class="app-install__main">
        <p class="h3 app-install__title" id="automatically-download-mobile-app" data-redirect>Download the app.</p>
        <div class="progress" id="mobile-app-progress">
          <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" style="width: 100%"></div>
        </div>
        <div class="app-install__stores d-none" id="mobile-app-links">
          <a id="mobile-app-ios-link" href="https://apps.apple.com/app/vocably-pro-language-cards/id1641258757" target="_blank"><img src="assets/download-on-app-store.svg" alt="Download on App Store" /></a>
          <a id="mobile-app-android-link" href="https://play.google.com/store/apps/details?id=com.vocablypro" target="_blank"><img src="assets/get-it-on-google-play.svg" alt="Get it on Google Play" /></a>
        </div>
      </div>
      <div class="app-install__qr hide-android hide-ios">
        <div>
          Scan this QR code to install the app
        </div>
        <img src="assets/qr-code.png" alt="Vocably App QR Code" />
      </div>
    </div>
  {{/text-container}}
{{/layout}}
