<style>
  .extensions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .install-extension-button {
    --bg-color: #2c2c2c;
    --bg-hover-color: #000;

    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1.375rem 0.5rem 3.25rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    font-size: 0.975rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.005em;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 1px 2px rgba(0, 0, 0, 0.12),
      0 4px 12px -2px rgba(0, 0, 0, 0.12);
    transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;

    &.chrome {
      background: var(--bg-color) url('assets/chrome.svg') 1rem center / 1.5rem no-repeat;
    }

    &.edge {
      background: var(--bg-color) url('assets/edge.svg') 1rem center / 1.5rem no-repeat;
    }

    &.safari {
      background: var(--bg-color) url('assets/safari.svg') 1rem center / 1.5rem no-repeat;
    }

    &:hover {
      color: #fff;
      background-color: var(--bg-hover-color);
      transform: translateY(-1px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.06),
        0 2px 4px rgba(0, 0, 0, 0.14),
        0 8px 20px -4px rgba(0, 0, 0, 0.2);
    }

    &:active {
      transform: translateY(0);
    }

    &:focus-visible {
      outline: 2px solid var(--bs-primary);
      outline-offset: 3px;
    }
  }
</style>
<div class="extensions {{class}}">
  <a class="install-extension-button chrome" href="https://chrome.google.com/webstore/detail/vocably/baocigmmhhdemijfjnjdidbkfgpgogmb">
    Chrome Extension
  </a>
  <a class="install-extension-button edge" href="https://microsoftedge.microsoft.com/addons/detail/dahphaiflimmafjchchidjmgidlkajho">
    Edge Extension
  </a>
  <a class="install-extension-button safari" href="https://apps.apple.com/us/app/vocably-for-safari/id6464076425">
    Safari Extension
  </a>
</div>
